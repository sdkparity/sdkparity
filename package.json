{
  "name": "sdkparity-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.0",
  "engines": {
    "node": ">=20.17 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "coverage": "turbo run coverage",
    "docs:dev": "cd . && mint dev",
    "docs:check": "mint broken-links && mint validate",
    "sdkparity": "bun apps/cli/src/bin.ts"
  },
  "devDependencies": {
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.3",
    "mint": "^4.2.568"
  },
  "dependencies": {
    "zod": "^4.1.13",
    "yaml": "^2.8.1"
  }
}
