{
  "name": "@sdkparity/openapi",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generator-config": {
      "types": "./dist/generator-config.d.ts",
      "import": "./dist/generator-config.js",
      "default": "./dist/generator-config.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -b tsconfig.json --force",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src",
    "coverage": "bun test src --coverage --coverage-reporter=text"
  },
  "dependencies": {
    "@sdkparity/core": "^0.1.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "description": "OpenAPI normalization and deterministic SDK generation helpers for SDK Parity.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sdkparity/sdkparity.git",
    "directory": "packages/openapi"
  },
  "homepage": "https://github.com/sdkparity/sdkparity#readme",
  "bugs": {
    "url": "https://github.com/sdkparity/sdkparity/issues"
  },
  "keywords": [
    "sdk",
    "openapi",
    "compatibility",
    "api",
    "agents"
  ]
}
